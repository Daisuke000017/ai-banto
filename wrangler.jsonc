{
  // AI番頭（Cloudflare Workers）。公開は社長の指示があったときだけ（2026-11-06 初回公開：ai-banto.daisuke-inoue.workers.dev）。
  // デモ公開は `npx wrangler deploy --var DEMO_TODAY:2026-10-10`（架空データのデモ用。実際の宿で使うときは --var を付けない）
  "name": "ai-banto",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // デモの「今日」（DEMO_TODAY）はここに書かない。本番に乗ると時計が止まるため（ゾロ審査 2026-11-05）
  // 手元では npm run dev が --var DEMO_TODAY:2026-10-10 を付けて起動する
  // 画面（public/）。先に Worker を通して、手元以外からの表示を止め・安全のヘッダーを付ける
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 朝の見回り（M19）：毎朝7時（日本時間＝UTCの22時）
  "triggers": {
    "crons": ["0 22 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-banto",
      "database_id": "b110e5e1-837d-4958-a08d-7fcbef726055",
      "migrations_dir": "migrations"
    }
  ]
}
